{
  "bdb": "theme",
  "format_version": 1,
  "theme_id": "haiku",
  "rev": 1,
  "name": {
    "ja": "Haiku",
    "en": "Haiku"
  },
  "description": {
    "ja": "システムの色と描画に従う",
    "en": "Follows the system colors and controls"
  },
  "native": true,
  "colors": {
    "panel": "#d8d8d8",
    "text": "#000000",
    "text_disabled": "#808080",
    "control_fill": "#ffffff",
    "control_border": "#acacac",
    "accent": "#0000e5",
    "link": "#0000ee",
    "bevel_light": "#ffffff",
    "bevel_dark": "#9e9e9e",
    "bevel_darker": "#747474"
  },
  "font": {
    "family": "",
    "style": "Regular",
    "size": 12
  },
  "kinds": {
    "text": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 1
      },
      "fill": "#ffffff"
    },
    "number": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 1
      },
      "fill": "#ffffff"
    },
    "bool": {
      "look": "raised",
      "border": {
        "visible": true,
        "width": 1
      }
    },
    "image": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 1
      }
    },
    "label": {
      "look": "none"
    },
    "button": {
      "look": "raised",
      "border": {
        "visible": true,
        "width": 1
      },
      "fill": "#e0e0e0",
      "pressed": "sunken"
    },
    "counter": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 1
      },
      "fill": "#e8e8e8"
    },
    "blank": {
      "look": "flat",
      "border": {
        "visible": true,
        "width": 1
      }
    }
  },
  "focus": {
    "color": "#0000e5",
    "width": 1
  }
}
