{
  "bdb": "theme",
  "format_version": 1,
  "theme_id": "beos",
  "rev": 1,
  "name": {
    "ja": "BeOS",
    "en": "BeOS"
  },
  "description": {
    "ja": "BeOS R5 風の、立体的な見た目",
    "en": "A beveled look in the style of BeOS R5"
  },
  "native": false,
  "colors": {
    "panel": "#d8d8d8",
    "text": "#000000",
    "text_disabled": "#808080",
    "control_fill": "#ffffff",
    "control_border": "#808080",
    "accent": "#ffcb00",
    "link": "#0000ee",
    "bevel_light": "#ffffff",
    "bevel_dark": "#909090",
    "bevel_darker": "#606060"
  },
  "font": {
    "family": "",
    "style": "Regular",
    "size": 12
  },
  "kinds": {
    "text": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 2
      },
      "fill": "#ffffff"
    },
    "number": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 2
      },
      "fill": "#ffffff"
    },
    "bool": {
      "look": "raised",
      "border": {
        "visible": true,
        "width": 2
      }
    },
    "image": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 2
      }
    },
    "label": {
      "look": "none"
    },
    "button": {
      "look": "raised",
      "border": {
        "visible": true,
        "width": 2
      },
      "fill": "#d8d8d8",
      "pressed": "sunken"
    },
    "counter": {
      "look": "sunken",
      "border": {
        "visible": true,
        "width": 1
      },
      "fill": "#e8e8e8"
    },
    "blank": {
      "look": "flat",
      "border": {
        "visible": true,
        "width": 1
      }
    }
  },
  "focus": {
    "color": "#ffcb00",
    "width": 2
  }
}
